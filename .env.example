# URL base do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Nome de uma tabela existente. O programa fará SELECT * LIMIT 1 nela.
SUPABASE_TABLE=nome_da_sua_tabela

# Alternativamente, informe a URL exata e ignore SUPABASE_TABLE:
# SUPABASE_PING_URL=https://seu-projeto.supabase.co/rest/v1/nome_da_sua_tabela?select=*&limit=1

# Chave anon/public para a API protegida pelo Supabase
SUPABASE_ANON_KEY=sua-chave-anon

PORT=3000
KEEP_ALIVE_INTERVAL_MINUTES=120
PING_TIMEOUT_MS=10000

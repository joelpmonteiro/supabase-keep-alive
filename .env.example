# URL base do projeto Supabase, usada como fallback para /rest/v1/
SUPABASE_URL=https://seu-projeto.supabase.co

# URL exata que receberá o ping. Recomenda-se uma tabela de healthcheck:
# SUPABASE_PING_URL=https://seu-projeto.supabase.co/rest/v1/keep_alive?select=id&limit=1

# Chave anon/public para APIs protegidas pelo Supabase
SUPABASE_ANON_KEY=sua-chave-anon

PORT=3000
KEEP_ALIVE_INTERVAL_MINUTES=120
PING_TIMEOUT_MS=10000
